{
  "name": "base-api",
  "version": "1.0.0",
  "description": "Botoseis base API: users, sessions, projects, lines, workflows, commands and programs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "server:dev": "tsx watch src/server.ts",
    "server:prod": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --write",
